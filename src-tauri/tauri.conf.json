{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "银行回单工作台",
  "version": "0.1.27",
  "identifier": "com.local.pdfsearch",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "银行回单工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.svg"
    ],
    "resources": {
      "../engine/*.py": "engine",
      "../.build/runtime/python/": "runtime/",
      "../engine/requirements*.txt": "engine/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "wix/zh-cn.wxl"
          }
        }
      },
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    }
  }
}
